<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Customer Process API Application Coordinates              -->
    <!-- ========================================================= -->

    <groupId>3566f43d-29f6-4a1e-ac94-4be9322c7333</groupId>
    <artifactId>customer-process-api-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>customer-process-api</name>


    <!-- ========================================================= -->
    <!-- Project Properties                                        -->
    <!-- ========================================================= -->

    <properties>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <project.reporting.outputEncoding>
            UTF-8
        </project.reporting.outputEncoding>

        <!-- Mule runtime and plugin versions -->
        <app.runtime>4.12.2</app.runtime>
        <mule.maven.plugin.version>4.10.2</mule.maven.plugin.version>
        <munit.version>3.7.5</munit.version>

        <!--
            Skip the Mule Maven Plugin Java support-matrix lookup.
            Java 17 support must remain declared in mule-artifact.json.
        -->
        <skipJavaVersionValidation>
            true
        </skipJavaVersionValidation>


        <!-- ===================================================== -->
        <!-- CloudHub 2.0 Deployment Properties                    -->
        <!-- ===================================================== -->

        <anypoint.org.id>
            ${env.ANYPOINT_ORG_ID}
        </anypoint.org.id>

        <cloudhub.environment>
            ${env.ANYPOINT_ENVIRONMENT}
        </cloudhub.environment>

        <cloudhub.target>
            ${env.CLOUDHUB_TARGET}
        </cloudhub.target>

        <cloudhub.application.name>
            ${env.PAPI_APPLICATION_NAME}
        </cloudhub.application.name>


        <!-- ===================================================== -->
        <!-- API Manager Autodiscovery                             -->
        <!-- ===================================================== -->

        <!--
            This value can remain even though global.xml contains
            the same hardcoded numeric API instance ID.
        -->
        <api.id>
            ${env.PAPI_API_ID}
        </api.id>


        <!-- ===================================================== -->
        <!-- Runtime Platform Credentials                          -->
        <!-- ===================================================== -->

        <anypoint.platform.client.id>
            ${env.ANYPOINT_PLATFORM_CLIENT_ID}
        </anypoint.platform.client.id>

        <anypoint.platform.client.secret>
            ${env.ANYPOINT_PLATFORM_CLIENT_SECRET}
        </anypoint.platform.client.secret>


        <!-- ===================================================== -->
        <!-- Secure Configuration Properties Key                   -->
        <!-- ===================================================== -->

        <mule.key>
            ${env.MULE_KEY}
        </mule.key>

    </properties>


    <!-- ========================================================= -->
    <!-- Build Configuration                                       -->
    <!-- ========================================================= -->

    <build>

        <plugins>

            <!-- Maven Clean Plugin -->
            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-clean-plugin
                </artifactId>

                <version>3.2.0</version>

            </plugin>


            <!-- ================================================= -->
            <!-- Mule Maven Plugin                                 -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.mule.tools.maven
                </groupId>

                <artifactId>
                    mule-maven-plugin
                </artifactId>

                <version>
                    ${mule.maven.plugin.version}
                </version>

                <extensions>true</extensions>

                <configuration>

                    <classifier>
                        mule-application
                    </classifier>

                    <skipJavaVersionValidation>
                        ${skipJavaVersionValidation}
                    </skipJavaVersionValidation>


                    <!-- ========================================= -->
                    <!-- CloudHub 2.0 Deployment                   -->
                    <!-- ========================================= -->

                    <cloudhub2Deployment>

                        <uri>
                            https://anypoint.mulesoft.com
                        </uri>

                        <provider>MC</provider>

                        <businessGroupId>
                            ${anypoint.org.id}
                        </businessGroupId>

                        <environment>
                            ${cloudhub.environment}
                        </environment>

                        <target>
                            ${cloudhub.target}
                        </target>

                        <muleVersion>
                            ${app.runtime}
                        </muleVersion>

                        <applicationName>
                            ${cloudhub.application.name}
                        </applicationName>


                        <!-- ===================================== -->
                        <!-- Connected App Deployment Credentials  -->
                        <!-- ===================================== -->

                        <connectedAppClientId>
                            ${env.CONNECTED_APP_CLIENT_ID}
                        </connectedAppClientId>

                        <connectedAppClientSecret>
                            ${env.CONNECTED_APP_CLIENT_SECRET}
                        </connectedAppClientSecret>

                        <connectedAppGrantType>
                            client_credentials
                        </connectedAppGrantType>


                        <!-- ===================================== -->
                        <!-- Runtime Allocation                    -->
                        <!-- ===================================== -->

                        <replicas>1</replicas>

                        <vCores>0.1</vCores>


                        <!-- ===================================== -->
                        <!-- Runtime Application Properties        -->
                        <!-- ===================================== -->

                        <properties>

                            <!--
                                This runtime property is retained for
                                consistency with the GitHub variable.

                                global.xml can continue using its
                                hardcoded numeric API instance ID.
                            -->
                            <api.id>
                                ${api.id}
                            </api.id>

                        </properties>


                        <!-- ===================================== -->
                        <!-- Protected Runtime Properties          -->
                        <!-- ===================================== -->

                        <secureProperties>

                            <anypoint.platform.client_id>
                                ${anypoint.platform.client.id}
                            </anypoint.platform.client_id>

                            <anypoint.platform.client_secret>
                                ${anypoint.platform.client.secret}
                            </anypoint.platform.client_secret>

                            <mule.key>
                                ${mule.key}
                            </mule.key>

                        </secureProperties>

                    </cloudhub2Deployment>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- MUnit Testing and Coverage                        -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    com.mulesoft.munit.tools
                </groupId>

                <artifactId>
                    munit-maven-plugin
                </artifactId>

                <version>
                    ${munit.version}
                </version>

                <executions>

                    <execution>

                        <id>test</id>

                        <phase>test</phase>

                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>

                    </execution>

                </executions>

                <configuration>

                    <coverage>

                        <runCoverage>true</runCoverage>

                        <formats>
                            <format>console</format>
                            <format>html</format>
                        </formats>

                    </coverage>

                </configuration>

            </plugin>

        </plugins>

    </build>


    <!-- ========================================================= -->
    <!-- Anypoint Exchange Publication                             -->
    <!-- ========================================================= -->

    <distributionManagement>

        <repository>

            <id>
                anypoint-exchange-v3
            </id>

            <name>
                Anypoint Exchange Repository
            </name>

            <url>
                https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven
            </url>

            <layout>default</layout>

        </repository>

        <snapshotRepository>

            <id>
                anypoint-exchange-v3
            </id>

            <name>
                Anypoint Exchange Snapshot Repository
            </name>

            <url>
                https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven
            </url>

            <layout>default</layout>

        </snapshotRepository>

    </distributionManagement>


    <!-- ========================================================= -->
    <!-- Mule Application Dependencies                             -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- HTTP Connector -->
        <dependency>

            <groupId>
                org.mule.connectors
            </groupId>

            <artifactId>
                mule-http-connector
            </artifactId>

            <version>1.11.3</version>

            <classifier>
                mule-plugin
            </classifier>

        </dependency>


        <!-- Sockets Connector -->
        <dependency>

            <groupId>
                org.mule.connectors
            </groupId>

            <artifactId>
                mule-sockets-connector
            </artifactId>

            <version>1.2.9</version>

            <classifier>
                mule-plugin
            </classifier>

        </dependency>


        <!-- Customer Process API RAML -->
        <dependency>

            <groupId>
                3566f43d-29f6-4a1e-ac94-4be9322c7333
            </groupId>

            <artifactId>
                customer-process-apiraml
            </artifactId>

            <version>1.0.0</version>

            <classifier>
                raml
            </classifier>

            <type>zip</type>

        </dependency>


        <!-- APIKit Module -->
        <dependency>

            <groupId>
                org.mule.modules
            </groupId>

            <artifactId>
                mule-apikit-module
            </artifactId>

            <version>1.12.2</version>

            <classifier>
                mule-plugin
            </classifier>

        </dependency>


        <!-- MUnit Runner -->
        <dependency>

            <groupId>
                com.mulesoft.munit
            </groupId>

            <artifactId>
                munit-runner
            </artifactId>

            <version>
                ${munit.version}
            </version>

            <classifier>
                mule-plugin
            </classifier>

            <scope>test</scope>

        </dependency>


        <!-- MUnit Tools -->
        <dependency>

            <groupId>
                com.mulesoft.munit
            </groupId>

            <artifactId>
                munit-tools
            </artifactId>

            <version>
                ${munit.version}
            </version>

            <classifier>
                mule-plugin
            </classifier>

            <scope>test</scope>

        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- Maven Repositories                                        -->
    <!-- ========================================================= -->

    <repositories>

        <!-- Anypoint Exchange -->
        <repository>

            <id>
                anypoint-exchange-v3
            </id>

            <name>
                Anypoint Exchange
            </name>

            <url>
                https://maven.anypoint.mulesoft.com/api/v3/maven
            </url>

            <layout>default</layout>

            <releases>
                <enabled>true</enabled>
            </releases>

            <snapshots>
                <enabled>true</enabled>
            </snapshots>

        </repository>


        <!-- MuleSoft Releases -->
        <repository>

            <id>
                mulesoft-releases
            </id>

            <name>
                MuleSoft Releases Repository
            </name>

            <url>
                https://repository.mulesoft.org/nexus/repository/releases/
            </url>

            <layout>default</layout>

            <releases>
                <enabled>true</enabled>
            </releases>

            <snapshots>
                <enabled>false</enabled>
            </snapshots>

        </repository>

    </repositories>


    <!-- ========================================================= -->
    <!-- Maven Plugin Repositories                                 -->
    <!-- ========================================================= -->

    <pluginRepositories>

        <pluginRepository>

            <id>
                mulesoft-releases
            </id>

            <name>
                MuleSoft Releases Repository
            </name>

            <url>
                https://repository.mulesoft.org/nexus/repository/releases/
            </url>

            <layout>default</layout>

            <releases>
                <enabled>true</enabled>
            </releases>

            <snapshots>
                <enabled>false</enabled>
            </snapshots>

        </pluginRepository>

    </pluginRepositories>

</project>