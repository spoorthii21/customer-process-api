<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<configuration doc:name="Configuration" doc:id="9394ece3-bd2f-4900-a316-e2b569c97f84" defaultErrorHandler-ref="global_error_handler" />
	<error-handler name="global_error_handler">

    <on-error-propagate type="HTTP:CONNECTIVITY">
        <set-variable variableName="httpStatus" value="#[503]" />
        <flow-ref name="common_error_handler"/>
    </on-error-propagate>

    <on-error-propagate type="CUSTOM:DUPLICATE_RECORD">
        <set-variable variableName="httpStatus" value="#[409]" />
        <flow-ref name="common_error_handler"/>
    </on-error-propagate>

    <on-error-propagate type="HTTP:NOT_FOUND">
        <set-variable variableName="httpStatus" value="#[404]" />
        <flow-ref name="common_error_handler"/>
    </on-error-propagate>

    <on-error-propagate type="HTTP:BAD_REQUEST">
        <set-variable variableName="httpStatus" value="#[400]" />
        <flow-ref name="common_error_handler"/>
    </on-error-propagate>

    <on-error-propagate type="ANY">
        <set-variable variableName="httpStatus" value="#[500]" />
        <flow-ref name="common_error_handler"/>
    </on-error-propagate>


</error-handler>

    <sub-flow name="common_error_handler">

    <logger level="ERROR" doc:name="log-error-details" message="Correlation ID: #[correlationId] | Error Type: #[error.errorType.identifier] | Error Message: #[error.description]" />
			<ee:transform doc:name="error_response">
        <ee:message>
            <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "failed",
    statusCode: vars.httpStatus,
    correlationId: correlationId,
    errorType: error.errorType.identifier,
    message: error.description
}
            ]]></ee:set-payload>
        </ee:message>
    </ee:transform>

</sub-flow>

</mule>
