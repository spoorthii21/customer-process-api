<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ========================================================= -->
    <!-- DEFAULT APPLICATION CONFIGURATION                         -->
    <!-- ========================================================= -->

    <configuration
        doc:name="Default Application Configuration"
        defaultErrorHandler-ref="global_error_handler"/>


    <!-- ========================================================= -->
    <!-- GLOBAL ERROR HANDLER                                      -->
    <!-- ========================================================= -->

    <error-handler
        name="global_error_handler">

        <!-- Downstream System API connectivity failure -->
        <on-error-propagate
            doc:name="Handle HTTP Connectivity Error"
            type="HTTP:CONNECTIVITY">

            <set-variable
                doc:name="Set HTTP Status 503"
                variableName="httpStatus"
                value="#[503]"/>

            <flow-ref
                doc:name="Build Common Error Response"
                name="common_error_handler"/>

        </on-error-propagate>


        <!-- Duplicate record business error -->
        <on-error-propagate
            doc:name="Handle Duplicate Record Error"
            type="CUSTOM:DUPLICATE_RECORD">

            <set-variable
                doc:name="Set HTTP Status 409"
                variableName="httpStatus"
                value="#[409]"/>

            <flow-ref
                doc:name="Build Common Error Response"
                name="common_error_handler"/>

        </on-error-propagate>


        <!-- Downstream resource not found -->
        <on-error-propagate
            doc:name="Handle HTTP Not Found Error"
            type="HTTP:NOT_FOUND">

            <set-variable
                doc:name="Set HTTP Status 404"
                variableName="httpStatus"
                value="#[404]"/>

            <flow-ref
                doc:name="Build Common Error Response"
                name="common_error_handler"/>

        </on-error-propagate>


        <!-- Invalid downstream request -->
        <on-error-propagate
            doc:name="Handle HTTP Bad Request Error"
            type="HTTP:BAD_REQUEST">

            <set-variable
                doc:name="Set HTTP Status 400"
                variableName="httpStatus"
                value="#[400]"/>

            <flow-ref
                doc:name="Build Common Error Response"
                name="common_error_handler"/>

        </on-error-propagate>


        <!-- All remaining unhandled errors -->
        <on-error-propagate
            doc:name="Handle Unexpected Error"
            type="ANY">

            <set-variable
                doc:name="Set HTTP Status 500"
                variableName="httpStatus"
                value="#[500]"/>

            <flow-ref
                doc:name="Build Common Error Response"
                name="common_error_handler"/>

        </on-error-propagate>

    </error-handler>


    <!-- ========================================================= -->
    <!-- COMMON ERROR RESPONSE HANDLER                             -->
    <!-- ========================================================= -->

    <sub-flow
        name="common_error_handler">

        <logger
            doc:name="Log Error Details"
            level="ERROR"
            message="#[
                'Correlation ID: ' ++ correlationId ++
                ' | Error Type: ' ++ error.errorType.identifier ++
                ' | Error Message: ' ++
                (error.description default 'Unexpected error')
            ]"/>

        <ee:transform
            doc:name="Build Error Response">

            <ee:message>

                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "failed",
    statusCode: vars.httpStatus default 500,
    correlationId: correlationId,
    errorType: error.errorType.identifier default "UNKNOWN",
    message: error.description default "Unexpected error"
}
                ]]></ee:set-payload>

            </ee:message>

        </ee:transform>

    </sub-flow>

</mule>