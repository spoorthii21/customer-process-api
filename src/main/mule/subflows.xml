<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ========================================================= -->
    <!-- CHECK CUSTOMER EXISTS                                     -->
    <!-- ========================================================= -->

    <sub-flow
        name="check-customer-exists-sub-flow"
        doc:id="e253e4be-b4fa-4394-aa75-3c5ee7acf226">

        <logger
            doc:name="Log Customer Verification Request"
            level="INFO"
            message="Customer verification: Fetching customer ID #[vars.customerId]"/>

        <http:request
            doc:name="Call Salesforce System API Get Contact By ID"
            doc:id="5464129f-456e-48e7-a682-64065b9efa7a"
            config-ref="salesforceSysApiRequestConfig"
            method="GET"
            path="/contacts/{id}"
            target="customerCheckResponse">

            <http:uri-params><![CDATA[#[output application/java
---
{
    id: vars.customerId
}]]]></http:uri-params>

        </http:request>

    </sub-flow>


    <!-- ========================================================= -->
    <!-- PROCESS ACCOUNT                                           -->
    <!-- ========================================================= -->

    <sub-flow
        name="process-account-logic-sub-flow"
        doc:id="711eebad-a183-4ef0-a7ab-bfef79174f3e">

        <logger
            doc:name="Log Account Lookup Start"
            level="DEBUG"
            message="Account processing: Checking whether account #[vars.originalPayload.accountName] already exists"/>

        <http:request
            doc:name="Call Salesforce System API Get Account By Name"
            config-ref="salesforceSysApiRequestConfig"
            method="GET"
            path="/accounts/name/{name}">

            <http:uri-params><![CDATA[#[output application/java
---
{
    name: vars.originalPayload.accountName
}]]]></http:uri-params>

            <http:response-validator>
                <http:success-status-code-validator
                    values="0..599"/>
            </http:response-validator>

        </http:request>

        <set-variable
            doc:name="Parse Account Lookup Response"
            variableName="accountCheckResponse"
            value="#[%dw 2.0
output application/json
---
if (payload is Binary or payload is String)
    read(payload, 'application/json')
else
    payload]"/>

        <set-variable
            doc:name="Store Account Lookup Status Code"
            variableName="accountCheckStatusCode"
            value="#[attributes.statusCode default 200]"/>

        <logger
            doc:name="Log Account Lookup Status"
            level="DEBUG"
            message="Account lookup returned HTTP status #[vars.accountCheckStatusCode]"/>

        <choice doc:name="Check Whether Account Exists">

            <!-- Existing account -->
            <when
                expression='#[vars.accountCheckStatusCode &lt; 400 and
                    (vars.accountCheckResponse.status default "failed") == "success" and
                    !isEmpty(vars.accountCheckResponse.data default [])]'>

                <logger
                    doc:name="Log Existing Account"
                    level="DEBUG"
                    message="Account already exists. Account creation will be skipped."/>

                <set-variable
                    doc:name="Store Existing Account ID"
                    variableName="finalAccountId"
                    value="#[
                        vars.accountCheckResponse.data[0].id
                        default vars.accountCheckResponse.data[0].Id
                    ]"/>

            </when>

            <!-- New account -->
            <otherwise>

                <logger
                    doc:name="Log New Account Creation"
                    level="DEBUG"
                    message="Account does not exist. Creating a new account."/>

                <ee:transform
                    doc:name="Build Account Creation Request">

                    <ee:message>

                        <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    name: vars.originalPayload.accountName,
    "type": "Customer"
}
                        ]]></ee:set-payload>

                    </ee:message>

                </ee:transform>

                <http:request
                    doc:name="Call Salesforce System API Create Account"
                    config-ref="salesforceSysApiRequestConfig"
                    method="POST"
                    path="/accounts">

                    <http:response-validator>
                        <http:success-status-code-validator
                            values="0..599"/>
                    </http:response-validator>

                </http:request>

                <set-variable
                    doc:name="Parse Account Creation Response"
                    variableName="accountCreateResponse"
                    value="#[
                        if (payload is Binary or payload is String)
                            read(payload, 'application/json')
                        else
                            payload
                    ]"/>

                <set-variable
                    doc:name="Store Account Creation Status Code"
                    variableName="accountCreateStatusCode"
                    value="#[attributes.statusCode default 201]"/>

                <logger
                    doc:name="Log Account Creation Status"
                    level="DEBUG"
                    message="Account creation returned HTTP status #[vars.accountCreateStatusCode]"/>

                <set-variable
                    doc:name="Store Created Account ID"
                    variableName="finalAccountId"
                    value="#[
                        vars.accountCreateResponse.id
                        default vars.accountCreateResponse.Id
                    ]"/>

            </otherwise>

        </choice>

    </sub-flow>


    <!-- ========================================================= -->
    <!-- PROCESS CONTACT                                           -->
    <!-- ========================================================= -->

    <sub-flow
        name="process-contact-logic-sub-flow"
        doc:id="9a00322e-b36f-4a30-aea6-b4c66b6803ea">

        <logger
            doc:name="Log Contact Lookup Start"
            level="DEBUG"
            message="Contact processing: Checking whether email #[vars.originalPayload.email] already exists"/>

        <http:request
            doc:name="Call Salesforce System API Get Contact By Email"
            config-ref="salesforceSysApiRequestConfig"
            method="GET"
            path="/contacts/email/{email}">

            <http:uri-params><![CDATA[#[output application/java
---
{
    email: vars.originalPayload.email
}]]]></http:uri-params>

            <http:response-validator>
                <http:success-status-code-validator
                    values="0..599"/>
            </http:response-validator>

        </http:request>

        <set-variable
            doc:name="Parse Contact Lookup Response"
            variableName="contactCheckResponse"
            value="#[%dw 2.0
output application/json
---
if (payload is Binary or payload is String)
    read(payload, 'application/json')
else
    payload]"/>

        <set-variable
            doc:name="Store Contact Lookup Status Code"
            variableName="contactCheckStatusCode"
            value="#[attributes.statusCode default 200]"/>

        <logger
            doc:name="Log Contact Lookup Status"
            level="DEBUG"
            message="Contact lookup returned HTTP status #[vars.contactCheckStatusCode]"/>

        <choice doc:name="Check Whether Contact Exists">

            <!-- Duplicate contact -->
            <when
                expression='#[vars.contactCheckStatusCode &lt; 400 and
                    (vars.contactCheckResponse.status default "failed") == "success" and
                    !isEmpty(vars.contactCheckResponse.data default null)]'>

                <logger
                    doc:name="Log Duplicate Contact"
                    level="DEBUG"
                    message="Duplicate contact found for email #[vars.originalPayload.email]. Customer creation will be stopped."/>

                <ee:transform
                    doc:name="Build Duplicate Contact Response"
                    doc:id="98e9f5c2-03fd-4700-8b29-cc18ab401117">

                    <ee:message>

                        <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "failed",
    errorCode: "DUPLICATE_CUSTOMER",
    message: "Customer already exists."
}
                        ]]></ee:set-payload>

                    </ee:message>

                    <ee:variables>

                        <ee:set-variable
                            variableName="httpStatus"><![CDATA[
409
                        ]]></ee:set-variable>

                    </ee:variables>

                </ee:transform>

                <raise-error
                    doc:name="Raise Duplicate Contact Error"
                    doc:id="e278725b-54d3-4dca-ad11-1c61ea750a79"
                    type="CUSTOM:DUPLICATE_RECORD"
                    description="Customer registration stopped because the contact email already exists."/>

            </when>

            <!-- New contact -->
            <otherwise>

                <logger
                    doc:name="Log New Contact Creation"
                    level="DEBUG"
                    message="Contact email is unique. Creating a new contact."/>

                <ee:transform
                    doc:name="Build Contact Creation Request"
                    doc:id="7d03ea50-06e4-467a-b00f-cc88a6b04638">

                    <ee:message>

                        <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    firstName: vars.originalPayload.firstName,
    lastName: vars.originalPayload.lastName,
    email: vars.originalPayload.email,
    accountId: vars.finalAccountId
}
                        ]]></ee:set-payload>

                    </ee:message>

                </ee:transform>

                <http:request
                    doc:name="Call Salesforce System API Create Contact"
                    config-ref="salesforceSysApiRequestConfig"
                    method="POST"
                    path="/contacts">

                    <http:response-validator>
                        <http:success-status-code-validator
                            values="0..599"/>
                    </http:response-validator>

                </http:request>

                <set-variable
                    doc:name="Parse Contact Creation Response"
                    variableName="contactCreateResponse"
                    value="#[
                        if (payload is Binary or payload is String)
                            read(payload, 'application/json')
                        else
                            payload
                    ]"/>

                <set-variable
                    doc:name="Store Created Contact ID"
                    variableName="finalContactId"
                    value="#[
                        vars.contactCreateResponse.id
                        default vars.contactCreateResponse.Id
                    ]"/>

                <logger
                    doc:name="Log Contact Creation Completion"
                    level="DEBUG"
                    message="Contact created successfully with ID #[vars.finalContactId]"/>

            </otherwise>

        </choice>

    </sub-flow>


    <!-- ========================================================= -->
    <!-- CREATE ACCOUNT                                            -->
    <!-- ========================================================= -->

    <sub-flow
        name="create-account-sub-flow"
        doc:id="dc670709-1201-458d-a123-6948ec39b733">

        <logger
            doc:name="Log Account Request Preparation"
            level="DEBUG"
            message="Preparing the Salesforce System API account creation request"/>

        <ee:transform
            doc:name="Build Account Creation Request"
            doc:id="c3d5b837-4d88-4b60-8934-fc939a3c58b6">

            <ee:message>

                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    name: vars.originalPayload.accountName,
    "type": "Customer"
}
                ]]></ee:set-payload>

            </ee:message>

        </ee:transform>

        <http:request
            doc:name="Call Salesforce System API Create Account"
            config-ref="salesforceSysApiRequestConfig"
            method="POST"
            path="/accounts"
            target="accountResult"/>

    </sub-flow>


    <!-- ========================================================= -->
    <!-- CREATE CONTACT                                            -->
    <!-- ========================================================= -->

    <sub-flow
        name="create-contact-sub-flow"
        doc:id="b96f8d03-f669-4f16-ae17-3ce9519edd13">

        <logger
            doc:name="Log Contact Request Preparation"
            level="INFO"
            message="Preparing the Salesforce System API contact creation request"/>

        <ee:transform
            doc:name="Build Contact Creation Request"
            doc:id="39e11019-146c-46ea-9ba6-92cda4c670ea">

            <ee:message>

                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    firstName: vars.originalPayload.firstName,
    lastName: vars.originalPayload.lastName,
    email: vars.originalPayload.email,
    accountId:
        vars.accountResult.id
        default vars.accountResult.Id
}
                ]]></ee:set-payload>

            </ee:message>

        </ee:transform>

        <http:request
            doc:name="Call Salesforce System API Create Contact"
            config-ref="salesforceSysApiRequestConfig"
            method="POST"
            path="/contacts"/>

    </sub-flow>

</mule>