<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <munit:config name="cases-flows-suite.xml"/>

    <!-- PATCH /cases/{caseId} -->
    <!-- NOTE: The production flow does NOT validate the customer.     -->
    <!-- It calls "Call SAPI PATCH Case" directly without any          -->
    <!-- prior GET Contact check. All PATCH tests must only mock       -->
    <!-- "Call SAPI PATCH Case".                                       -->

    <!-- TEST 1: PATCH SUCCESS -->
    <munit:test name="patch-case-success-test" description="PATCH case returns 200 with updated case data">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAPI PATCH Case Success">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "success", message: "Case updated successfully", caseId: "500bm00003DfPvtAAF", data: { status: "Closed", priority: "Low" } }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 200 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set PATCH Case Request">
                <munit:payload mediaType="application/java" value='#[{ customerId: "003bm000022PMWDAA4", status: "Closed", priority: "Low" }]'/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { caseId: "500bm00003DfPvtAAF" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run PATCH Case Flow" name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert PATCH Success Status" expression="#[payload.status]" is='#[MunitTools::equalTo("success")]'/>
            <munit-tools:assert-that doc:name="Assert Updated Case ID" expression="#[payload.caseId]" is='#[MunitTools::equalTo("500bm00003DfPvtAAF")]'/>
            <munit-tools:assert-that doc:name="Assert PATCH HTTP Status 200" expression="#[vars.httpStatus default null]" is="#[MunitTools::equalTo(200)]"/>
            <munit-tools:verify-call doc:name="Verify PATCH Case Called Once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- TEST 2: PATCH CASE NOT FOUND (SAPI 404) -->
    <munit:test name="patch-case-not-found-test" description="PATCH case returns 404 when the Case does not exist">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAPI PATCH Case Not Found">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "failed", errorCode: "CASE_NOT_FOUND", message: "Support case does not exist.", errorDescription: "The System API rejected the case update request.", correlationId: "munit-patch-case-not-found" }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 404 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set PATCH Case Not Found Request">
                <munit:payload mediaType="application/java" value='#[{ customerId: "003bm000022PMWDAA4", status: "Closed", priority: "Low" }]'/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { caseId: "500bm00003InvalidAAF" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run PATCH Case Not Found Flow" name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert PATCH Not Found Status" expression="#[payload.status]" is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert CASE_NOT_FOUND Error Code" expression="#[payload.errorCode]" is='#[MunitTools::equalTo("CASE_NOT_FOUND")]'/>
            <munit-tools:assert-that doc:name="Assert PATCH 404 Status" expression="#[vars.httpStatus default null]" is="#[MunitTools::equalTo(404)]"/>
            <munit-tools:verify-call doc:name="Verify PATCH Case Called Once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- TEST 3: PATCH CASE SAPI 503 - SYSTEM_API_UNAVAILABLE -->
    <!-- FIX: was "patch-case-customer-not-found-test" which incorrectly mocked -->
    <!-- "Call SAPI GET Contact By ID" - PATCH flow has no customer validation. -->
    <!-- Replaced with a valid SAPI 503 scenario the flow actually handles.     -->
    <munit:test name="patch-case-customer-not-found-test" description="PATCH case returns 503 SYSTEM_API_UNAVAILABLE when SAPI is unavailable">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAPI PATCH Case 503">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "failed", errorCode: "SYSTEM_API_UNAVAILABLE", message: "The case update service is temporarily unavailable." }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 503 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set PATCH Case Request">
                <munit:payload mediaType="application/java" value='#[{ customerId: "003bm000022PMWDAA4", status: "Closed", priority: "Low" }]'/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { caseId: "500bm00003DfPvtAAF" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run PATCH Case 503 Flow" name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Status Failed" expression="#[payload.status]" is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert SYSTEM_API_UNAVAILABLE" expression="#[payload.errorCode]" is='#[MunitTools::equalTo("SYSTEM_API_UNAVAILABLE")]'/>
            <munit-tools:assert-that doc:name="Assert HTTP Status 503" expression="#[vars.httpStatus default null]" is="#[MunitTools::equalTo(503)]"/>
            <munit-tools:verify-call doc:name="Verify PATCH Case Called Once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- TEST 4: PATCH CASE SAPI 400 - INVALID_CASE_UPDATE -->
    <!-- FIX: was "patch-case-empty-contact-id-test" which mocked              -->
    <!-- "Call SAPI GET Contact By ID" - PATCH flow has no customer validation. -->
    <munit:test name="patch-case-empty-contact-id-test" description="PATCH case returns 400 INVALID_CASE_UPDATE when SAPI rejects the payload">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAPI PATCH Case 400">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "failed", errorCode: "INVALID_CASE_UPDATE", message: "The supplied case update values are invalid." }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 400 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set PATCH Case Invalid Payload Request">
                <munit:payload mediaType="application/java" value='#[{ status: "UNKNOWN_STATUS", priority: "INVALID" }]'/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { caseId: "500bm00003DfPvtAAF" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run PATCH Case 400 Flow" name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Status Failed" expression="#[payload.status]" is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert INVALID_CASE_UPDATE" expression="#[payload.errorCode]" is='#[MunitTools::equalTo("INVALID_CASE_UPDATE")]'/>
            <munit-tools:assert-that doc:name="Assert HTTP Status 400" expression="#[vars.httpStatus default null]" is="#[MunitTools::equalTo(400)]"/>
            <munit-tools:verify-call doc:name="Verify PATCH Case Called Once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- TEST 5: PATCH CASE SAPI 500 - CASE_UPDATE_FAILED -->
    <!-- FIX: was "patch-case-missing-customer-id-test" which had NO mock and   -->
    <!-- expected INVALID_CUSTOMER_ID - PATCH flow does not check customerId.   -->
    <munit:test name="patch-case-missing-customer-id-test" description="PATCH case returns 500 CASE_UPDATE_FAILED when SAPI returns a generic error">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAPI PATCH Case 500">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "failed", errorCode: "CASE_UPDATE_FAILED", message: "The support case could not be updated." }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 500 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set PATCH Case 500 Request">
                <munit:payload mediaType="application/java" value='#[{ status: "Closed", priority: "Low" }]'/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { caseId: "500bm00003DfPvtAAF" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run PATCH Case 500 Flow" name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Status Failed" expression="#[payload.status]" is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert CASE_UPDATE_FAILED" expression="#[payload.errorCode]" is='#[MunitTools::equalTo("CASE_UPDATE_FAILED")]'/>
            <munit-tools:assert-that doc:name="Assert HTTP Status 500" expression="#[vars.httpStatus default null]" is="#[MunitTools::equalTo(500)]"/>
            <munit-tools:verify-call doc:name="Verify PATCH Case Called Once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- TEST 6: PATCH CASE SAPI returns 200 but body.status = "failed"        -->
    <!-- FIX: was "patch-case-customer-service-unavailable-test" which mocked  -->
    <!-- "Call SAPI GET Contact By ID" - PATCH flow has no customer validation. -->
    <!-- The flow's choice condition also checks body status even on HTTP 200.  -->
    <munit:test name="patch-case-customer-service-unavailable-test" description="PATCH case returns failed when SAPI HTTP 200 but response body indicates failure">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAPI PATCH Case Body Failure">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "failed", errorCode: "CASE_UPDATE_FAILED", message: "Case update was rejected by the downstream system." }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 200 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set PATCH Case Body Failure Request">
                <munit:payload mediaType="application/java" value='#[{ customerId: "003bm000022PMWDAA4", status: "Closed", priority: "Low" }]'/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { caseId: "500bm00003DfPvtAAF" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run PATCH Case Body Failure Flow" name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Status Failed" expression="#[payload.status]" is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert CASE_UPDATE_FAILED errorCode" expression="#[payload.errorCode]" is='#[MunitTools::equalTo("CASE_UPDATE_FAILED")]'/>
            <munit-tools:verify-call doc:name="Verify PATCH Case Called Once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- GET /customers/{customerId}/cases -->

    <!-- TEST 7: GET CASE HISTORY SUCCESS -->
    <munit:test name="get-customer-case-history-success-test" description="GET case history returns 200 with cases list">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock GET Contact Success For History">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI GET Contact By ID"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "success", message: "Customer retrieved successfully", data: { contactId: "003bm00000ABC123", firstName: "Test", lastName: "Customer" } }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 200 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request" doc:name="Mock GET Customer Cases Success">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI GET Customer Cases"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "success", message: "Cases retrieved successfully", data: [ { caseId: "500bm00003DfPvtAAF", subject: "Login Issue", description: "Customer cannot log in", priority: "High", status: "Open" } ] }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 200 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set GET Case History Request">
                <munit:payload mediaType="application/java" value="#[{}]"/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { customerId: "003bm00000ABC123" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Run GET Customer Cases Flow" name="get:\customers\(customerId)\cases:customer-process-apiraml-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert GET History Success" expression="#[payload.status]" is='#[MunitTools::equalTo("success")]'/>
            <munit-tools:assert-that doc:name="Assert GET Customer ID" expression="#[payload.customerId]" is='#[MunitTools::equalTo("003bm00000ABC123")]'/>
            <munit-tools:assert-that doc:name="Assert One Case Returned" expression="#[sizeOf(payload.cases)]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that doc:name="Assert Returned Case ID" expression="#[payload.cases[0].caseId]" is='#[MunitTools::equalTo("500bm00003DfPvtAAF")]'/>
            <munit-tools:assert-that doc:name="Assert GET History HTTP Status 200" expression="#[vars.httpStatus default null]" is="#[MunitTools::equalTo(200)]"/>
        </munit:validation>
    </munit:test>

