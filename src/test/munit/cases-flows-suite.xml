    <!-- TEST 3: GET CASE HISTORY SUCCESS -->

    <munit:test
        name="get-customer-case-history-success-test"
        description="GET case history returns 200 with cases list">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock GET Contact Success For History">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Contact By ID"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "Customer retrieved successfully",
                            data: {
                                contactId: "003bm00000ABC123",
                                firstName: "Test",
                                lastName: "Customer"
                            }
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock GET Customer Cases Success">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Customer Cases"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "Cases retrieved successfully",
                            data: [
                                {
                                    caseId: "500bm00003DfPvtAAF",
                                    subject: "Login Issue",
                                    description: "Customer cannot log in",
                                    priority: "High",
                                    status: "Open"
                                }
                            ]
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set GET Case History Request">

                <munit:payload
                    mediaType="application/java"
                    value="#[{}]"/>

                <munit:attributes
                    mediaType="application/java"
                    value='#[{
                        uriParams: {
                            customerId: "003bm00000ABC123"
                        }
                    }]'/>

            </munit:set-event>

            <flow-ref
                doc:name="Run GET Customer Cases Flow"
                name="get:\customers\(customerId)\cases:customer-process-apiraml-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert GET History Success"
                expression="#[payload.status]"
                is='#[MunitTools::equalTo("success")]'/>

            <munit-tools:assert-that
                doc:name="Assert GET Customer ID"
                expression="#[payload.customerId]"
                is='#[MunitTools::equalTo("003bm00000ABC123")]'/>

            <munit-tools:assert-that
                doc:name="Assert One Case Returned"
                expression="#[sizeOf(payload.cases)]"
                is="#[MunitTools::equalTo(1)]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Case ID"
                expression="#[payload.cases[0].caseId]"
                is='#[MunitTools::equalTo("500bm00003DfPvtAAF")]'/>

            <munit-tools:assert-that
                doc:name="Assert GET History HTTP Status 200"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::equalTo(200)]"/>

        </munit:validation>

    </munit:test>

