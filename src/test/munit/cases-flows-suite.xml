    <!-- TEST 10: GET CASE HISTORY - CASE RETRIEVAL FAILURE -->
    <munit:test name="get-case-history-retrieval-failure" description="Case history retrieval failure returns HTTP 500">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock GET Contact Success">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI GET Contact By ID"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "success", message: "Customer retrieved successfully", data: { contactId: "003bm000022PMWDAA4", firstName: "Test", lastName: "Customer" } }]'/>
