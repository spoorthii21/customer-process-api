                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request" doc:name="Mock GET Customer Cases Failure">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Call SAPI GET Customer Cases"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{ status: "failed", errorCode: "CASE_HISTORY_RETRIEVAL_FAILED", message: "Unable to retrieve cases for this customer.", errorDescription: "The System API could not retrieve the case history.", correlationId: "munit-case-history-failure" }]'/>
                    <munit-tools:attributes mediaType="application/java" value="#[{ statusCode: 500 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set GET Case History Failure Request">
                <munit:payload mediaType="application/java" value="#[{}]"/>
                <munit:attributes mediaType="application/java" value='#[{ uriParams: { customerId: "003bm000022PMWDAA4" } }]'/>
            </munit:set-event>
            <flow-ref doc:name="Execute GET Customer Cases Flow" name="get:\customers\(customerId)\cases:customer-process-apiraml-config"/>
        </munit:execution>
