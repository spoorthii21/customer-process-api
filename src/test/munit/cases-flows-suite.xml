    <!-- ============================================================= -->
    <!-- PATCH /cases/{caseId}                                        -->
    <!-- ============================================================= -->

    <!-- TEST 1: PATCH CASE SUCCESS -->

    <munit:test
        name="patch-case-success-test"
        description="PATCH case returns 200 with updated case data">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock SAPI PATCH Case Success">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "Case updated successfully",
                            caseId: "500bm00003DfPvtAAF"
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set PATCH Case Request">

                <munit:payload
                    mediaType="application/java"
                    value='#[{
                        status: "Closed",
                        priority: "Low"
                    }]'/>

                <munit:attributes
                    mediaType="application/java"
                    value='#[{
                        uriParams: {
                            caseId: "500ABC123"
                        }
                    }]'/>

            </munit:set-event>

            <flow-ref
                doc:name="Run PATCH Case Flow"
                name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert PATCH Success Status"
                expression="#[payload.status]"
                is='#[MunitTools::equalTo("success")]'/>

            <munit-tools:assert-that
                doc:name="Assert Updated Case ID"
                expression="#[payload.caseId]"
                is='#[MunitTools::equalTo("500bm00003DfPvtAAF")]'/>

            <munit-tools:assert-that
                doc:name="Assert PATCH HTTP Status 200"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::equalTo(200)]"/>

            <munit-tools:verify-call
                doc:name="Verify PATCH Case Called Once"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- TEST 2: PATCH CASE NOT FOUND -->

    <munit:test
        name="patch-case-not-found-test"
        description="PATCH case returns 404 CASE_NOT_FOUND">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock SAPI PATCH Case Not Found">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI PATCH Case"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "failed",
                            errorCode: "CASE_NOT_FOUND",
                            message: "Support case does not exist.",
                            errorDescription:
                                "The System API rejected the case update request.",
                            correlationId: "munit-patch-case-not-found"
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 404
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set PATCH Case Not Found Request">

                <munit:payload
                    mediaType="application/java"
                    value='#[{
                        status: "Closed",
                        priority: "Low"
                    }]'/>

                <munit:attributes
                    mediaType="application/java"
                    value='#[{
                        uriParams: {
                            caseId: "500bm00003InvalidAAF"
                        }
                    }]'/>

            </munit:set-event>

            <flow-ref
                doc:name="Run PATCH Case Not Found Flow"
                name="patch:\cases\(caseId):application\json:customer-process-apiraml-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert PATCH Not Found Status"
                expression="#[payload.status]"
                is='#[MunitTools::equalTo("failed")]'/>

            <munit-tools:assert-that
                doc:name="Assert CASE_NOT_FOUND Error Code"
                expression="#[payload.errorCode]"
                is='#[MunitTools::equalTo("CASE_NOT_FOUND")]'/>

            <munit-tools:assert-that
                doc:name="Assert PATCH 404 Status"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::equalTo(404)]"/>

        </munit:validation>

    </munit:test>

