            <flow-ref
                doc:name="Execute GET Customer Flow"
                name="get:\customers\(customerId):customer-process-apiraml-config"/>

        </munit:execution>

    </munit:test>

    <!-- ============================================================= -->
    <!-- TEST 7: POST CUSTOMER SUCCESS                                -->
    <!-- ============================================================= -->

    <munit:test
        name="post-customer-success"
        description="POST customer completes orchestration successfully">

        <munit:behavior>

            <munit-tools:mock-when
                processor="flow-ref"
                doc:name="Mock Account Processing Success">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Account Processing"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:variables>
                        <munit-tools:variable
                            key="finalAccountId"
                            value='#["001bm00000ABC123"]'
                            mediaType="application/java"/>
                    </munit-tools:variables>

                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="flow-ref"
                doc:name="Mock Contact Processing Success">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Contact Processing"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:variables>
                        <munit-tools:variable
                            key="finalContactId"
                            value='#["003bm000022PMWDAA4"]'
                            mediaType="application/java"/>
                    </munit-tools:variables>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set POST Customer Request">

                <munit:payload
                    mediaType="application/java"
                    value='#[{
                        accountName: "Acme Corp",
                        firstName: "Jane",
                        lastName: "Smith",
                        email: "jane.smith@acme.com"
                    }]'/>

            </munit:set-event>

            <flow-ref
                doc:name="Execute POST Customer Flow"
                name="post:\customers:application\json:customer-process-apiraml-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert POST Success"
                expression="#[payload.status]"
                is='#[MunitTools::equalTo("success")]'/>

            <munit-tools:assert-that
                doc:name="Assert Final Account ID"
                expression="#[payload.data.accountId]"
                is='#[MunitTools::equalTo("001bm00000ABC123")]'/>

            <munit-tools:assert-that
                doc:name="Assert Final Contact ID"
                expression="#[payload.data.contactId]"
                is='#[MunitTools::equalTo("003bm000022PMWDAA4")]'/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status 201"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::equalTo(201)]"/>

            <munit-tools:verify-call
                processor="flow-ref"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Account Processing"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="flow-ref"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Contact Processing"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

</mule>