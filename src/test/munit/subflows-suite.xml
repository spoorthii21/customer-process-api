<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <munit:config name="subflows-suite.xml"/>

    <!-- ========================================================= -->
    <!-- TEST 01: CHECK CUSTOMER EXISTS                            -->
    <!-- ========================================================= -->

    <munit:test
        name="check-customer-exists-success-test"
        description="Verify the contact lookup response is stored in customerCheckResponse">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Get Contact By ID"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Contact By ID"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:variables>
                        <munit-tools:variable
                            key="customerCheckResponse"
                            mediaType="application/json"
                            value="#[output application/json
---
{
    status: 'success',
    data: {
        contactId: '003bm000022PMWDAA4',
        firstName: 'John',
        lastName: 'Doe'
    }
}]"/>
                    </munit-tools:variables>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Customer Verification Event">

                <munit:variables>
                    <munit:variable
                        key="customerId"
                        value="#['003bm000022PMWDAA4']"
                        mediaType="application/java"/>
                </munit:variables>

            </munit:set-event>

            <flow-ref
                doc:name="Execute Check Customer Exists Subflow"
                name="check-customer-exists-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Customer Check Status"
                expression="#[vars.customerCheckResponse.status]"
                is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                doc:name="Assert Customer Check Contact ID"
                expression="#[vars.customerCheckResponse.data.contactId]"
                is="#[MunitTools::equalTo('003bm000022PMWDAA4')]"/>

            <munit-tools:verify-call
                doc:name="Verify Contact Lookup Called Once"
                processor="http:request"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Contact By ID"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ========================================================= -->
    <!-- TEST 02: PROCESS EXISTING ACCOUNT                         -->
    <!-- ========================================================= -->

    <munit:test
        name="process-account-existing-account-test"
        description="Verify an existing account ID is selected without creating another account">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Existing Account Lookup"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Account By Name"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/json"
                        value="#[output application/json
---
{
    status: 'success',
    message: 'Account found',
    data: [
        {
            id: '001bm00000ABC123',
            name: 'Acme Corp',
            'type': 'Customer'
        }
    ]
}]"/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{statusCode: 200}]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Existing Account Event">

                <munit:variables>

                    <munit:variable
                        key="originalPayload"
                        mediaType="application/json"
                        value="#[output application/json
---
{
    accountName: 'Acme Corp',
    firstName: 'Jane',
    lastName: 'Smith',
    email: 'jane@acme.com'
}]"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                doc:name="Execute Process Account Logic Subflow"
                name="process-account-logic-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Existing Account ID"
                expression="#[vars.finalAccountId]"
                is="#[MunitTools::equalTo('001bm00000ABC123')]"/>

            <munit-tools:assert-that
                doc:name="Assert Existing Account Type"
                expression="#[vars.accountCheckResponse.data[0]['type']]"
                is="#[MunitTools::equalTo('Customer')]"/>

            <munit-tools:assert-that
                doc:name="Assert Account Lookup Status Code"
                expression="#[vars.accountCheckStatusCode]"
                is="#[MunitTools::equalTo(200)]"/>

            <munit-tools:verify-call
                doc:name="Verify Existing Account Lookup Called Once"
                processor="http:request"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Account By Name"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                doc:name="Verify Account Creation Was Not Called"
                processor="http:request"
                times="0">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Create Account"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ========================================================= -->
    <!-- TEST 03: PROCESS NEW ACCOUNT                              -->
    <!-- ========================================================= -->

    <munit:test
        name="process-account-new-account-test"
        description="Verify a missing account is created and its ID is stored">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Empty Account Lookup"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Account By Name"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/json"
                        value="#[output application/json
---
{
    status: 'success',
    message: 'No accounts found',
    data: []
}]"/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{statusCode: 200}]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Account Creation"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Create Account"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/json"
                        value="#[output application/json
---
{
    id: '001bm00000NEW456',
    name: 'New Corp',
    'type': 'Customer'
}]"/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{statusCode: 201}]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set New Account Event">

                <munit:variables>

                    <munit:variable
                        key="originalPayload"
                        mediaType="application/json"
                        value="#[output application/json
---
{
    accountName: 'New Corp',
    firstName: 'Tom',
    lastName: 'Jones',
    email: 'tom@newcorp.com'
}]"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                doc:name="Execute Process Account Logic Subflow"
                name="process-account-logic-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Created Account ID"
                expression="#[vars.finalAccountId]"
                is="#[MunitTools::equalTo('001bm00000NEW456')]"/>

            <munit-tools:assert-that
                doc:name="Assert Created Account Type"
                expression="#[vars.accountCreateResponse['type']]"
                is="#[MunitTools::equalTo('Customer')]"/>

            <munit-tools:assert-that
                doc:name="Assert Account Creation Status Code"
                expression="#[vars.accountCreateStatusCode]"
                is="#[MunitTools::equalTo(201)]"/>

            <munit-tools:verify-call
                doc:name="Verify Empty Account Lookup Called Once"
                processor="http:request"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Account By Name"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                doc:name="Verify Account Creation Called Once"
                processor="http:request"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Create Account"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ========================================================= -->
    <!-- TEST 04: PROCESS DUPLICATE CONTACT                        -->
    <!-- ========================================================= -->

    <munit:test
        name="process-contact-duplicate-contact-test"
        description="Verify an existing contact raises CUSTOM:DUPLICATE_RECORD"
        expectedErrorType="CUSTOM:DUPLICATE_RECORD">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Existing Contact Lookup"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Get Contact By Email"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/json"
                        value="#[output application/json
---
{
    status: 'success',
    message: 'Contact found',
    data: {
        contactId: '003bm000022PMWDAA4',
        firstName: 'Jane',
        lastName: 'Smith',
        email: 'jane@acme.com'
    }
}]"/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{statusCode: 200}]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Duplicate Contact Event">

                <munit:variables>

                    <munit:variable
                        key="originalPayload"
                        mediaType="application/json"
                        value="#[output application/json
---
{
    firstName: 'Jane',
    lastName: 'Smith',
    email: 'jane@acme.com'
}]"/>

                    <munit:variable
                        key="finalAccountId"
                        value="#['001bm00000ABC123']"
                        mediaType="application/java"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                doc:name="Execute Process Contact Logic Subflow"
                name="process-contact-logic-sub-flow"/>

        </munit:execution>

    </munit:test>

