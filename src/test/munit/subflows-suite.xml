<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <munit:config name="subflows-suite.xml"/>

    <!-- ================================================================ -->
    <!-- TEST 1: check-customer-exists-sub-flow                          -->
    <!-- Processors: logger + http:request (target=customerCheckResponse) -->
    <!-- FIX: whereValue uses exact production doc:name "By Id" (lowercase d) -->
    <!-- ================================================================ -->

<munit:test
        name="check-customer-exists-success"
        description="check-customer-exists-sub-flow stores GET Contact response in customerCheckResponse var">

    <munit:behavior>

        <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI GET Contact By Id">

            <munit-tools:with-attributes>
                <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Contact By Id"/>
            </munit-tools:with-attributes>

            <munit-tools:then-return>

                <munit-tools:variables>
                    <munit-tools:variable
                            key="customerCheckResponse"
                            mediaType="application/java"
                            value='#[{
                                status: "success",
                                data: {
                                    contactId: "003bm000022PMWDAA4",
                                    firstName: "John",
                                    lastName: "Doe"
                                }
                            }]'/>
                </munit-tools:variables>

            </munit-tools:then-return>

        </munit-tools:mock-when>

    </munit:behavior>

    <munit:execution>

        <munit:set-event doc:name="Set Check Customer Event">

            <munit:variables>
                <munit:variable
                        key="customerId"
                        value='#["003bm000022PMWDAA4"]'
                        mediaType="application/java"/>
            </munit:variables>

        </munit:set-event>

        <flow-ref
                doc:name="Execute check-customer-exists-sub-flow"
                name="check-customer-exists-sub-flow"/>

    </munit:execution>

    <munit:validation>

        <munit-tools:assert-that
                doc:name="Assert Customer Check Status"
                expression="#[vars.customerCheckResponse.status]"
                is='#[MunitTools::equalTo("success")]'/>

        <munit-tools:assert-that
                doc:name="Assert Customer Check Contact ID"
                expression="#[vars.customerCheckResponse.data.contactId]"
                is='#[MunitTools::equalTo("003bm000022PMWDAA4")]'/>

        <munit-tools:verify-call
                doc:name="Verify GET Contact By Id Called Once"
                processor="http:request"
                times="1">

            <munit-tools:with-attributes>
                <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Contact By Id"/>
            </munit-tools:with-attributes>

        </munit-tools:verify-call>

    </munit:validation>

</munit:test>
    <!-- ================================================================ -->
    <!-- TEST 2: process-account-logic-sub-flow — WHEN (account exists)   -->
    <!-- Covers: logger, GET account, parse vars x2, logger,             -->
    <!--   choice-when: logger + set-variable (Store Existing Account ID) -->
    <!-- ================================================================ -->

    <munit:test
        name="process-account-exists-branch"
        description="process-account-logic: existing account found, finalAccountId set from data[0].id">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI GET Account By Name Exists">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Account By Name"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "Account found",
                            data: [
                                {
                                    id: "001bm00000ABC123",
                                    name: "Acme Corp",
                                    "type": "Customer"
                                }
                            ]
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Process Account Exists Event">
                <munit:variables>
                    <munit:variable
                        key="originalPayload"
                        value='#[{
                            accountName: "Acme Corp",
                            firstName: "Jane",
                            lastName: "Smith",
                            email: "jane@acme.com"
                        }]'
                        mediaType="application/java"/>
                </munit:variables>
            </munit:set-event>

            <flow-ref
                doc:name="Execute process-account-logic-sub-flow Exists"
                name="process-account-logic-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert finalAccountId set from existing account"
                expression="#[vars.finalAccountId]"
                is='#[MunitTools::equalTo("001bm00000ABC123")]'/>

            <munit-tools:verify-call
                doc:name="Verify GET Account By Name called once for exists"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Account By Name"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

            <munit-tools:verify-call
                doc:name="Verify POST Account NOT called when account exists"
                processor="http:request"
                times="0">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI POST Account"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ================================================================ -->
    <!-- TEST 3: process-account-logic-sub-flow — OTHERWISE (create)      -->
    <!-- Covers: logger, transform, POST account, parse vars x3           -->
    <!-- FIX: POST mock payload uses double-quoted "type" key             -->
    <!-- ================================================================ -->

    <munit:test
        name="process-account-create-branch"
        description="process-account-logic: account missing, new account created, finalAccountId from POST response">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI GET Account By Name Missing">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Account By Name"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "No accounts found",
                            data: []
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI POST Account Create">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI POST Account"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            id: "001bm00000NEW456",
                            name: "New Corp",
                            "type": "Customer"
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 201
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Process Account Create Event">
                <munit:variables>
                    <munit:variable
                        key="originalPayload"
                        value='#[{
                            accountName: "New Corp",
                            firstName: "Tom",
                            lastName: "Jones",
                            email: "tom@newcorp.com"
                        }]'
                        mediaType="application/java"/>
                </munit:variables>
            </munit:set-event>

            <flow-ref
                doc:name="Execute process-account-logic-sub-flow Create"
                name="process-account-logic-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert finalAccountId set from new account POST response"
                expression="#[vars.finalAccountId]"
                is='#[MunitTools::equalTo("001bm00000NEW456")]'/>

            <munit-tools:verify-call
                doc:name="Verify GET Account By Name called once for create"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Account By Name"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

            <munit-tools:verify-call
                doc:name="Verify POST Account called once to create"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI POST Account"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ================================================================ -->
    <!-- TEST 4: process-contact-logic-sub-flow — WHEN (duplicate)        -->
    <!-- Covers: logger, GET contact, parse vars x2, logger,             -->
    <!--   choice-when: logger + transform + raise-error                  -->
    <!-- Raises CUSTOM:DUPLICATE_RECORD                                   -->
    <!-- ================================================================ -->

    <munit:test
        name="process-contact-duplicate-branch"
        description="process-contact-logic: contact found, raises CUSTOM:DUPLICATE_RECORD"
        expectedErrorType="CUSTOM:DUPLICATE_RECORD">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI GET Contact By Email Existing">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Contact By Email"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "Contact found",
                            data: {
                                contactId: "003bm000022PMWDAA4",
                                firstName: "Jane",
                                email: "jane@acme.com"
                            }
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Process Contact Duplicate Event">
                <munit:variables>
                    <munit:variable
                        key="originalPayload"
                        value='#[{
                            firstName: "Jane",
                            lastName: "Smith",
                            email: "jane@acme.com"
                        }]'
                        mediaType="application/java"/>
                    <munit:variable
                        key="finalAccountId"
                        value='#["001bm00000ABC123"]'
                        mediaType="application/java"/>
                </munit:variables>
            </munit:set-event>

            <flow-ref
                doc:name="Execute process-contact-logic-sub-flow Duplicate"
                name="process-contact-logic-sub-flow"/>

        </munit:execution>

    </munit:test>

    <!-- ================================================================ -->
    <!-- TEST 5: process-contact-logic-sub-flow — OTHERWISE (new contact)  -->
    <!-- Covers: logger, transform, POST contact, parse vars x2           -->
    <!-- ================================================================ -->

    <munit:test
        name="process-contact-new-creation-branch"
        description="process-contact-logic: contact not found, new contact created, finalContactId set">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI GET Contact By Email Not Found">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Contact By Email"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            status: "success",
                            message: "No contact found",
                            data: null
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 200
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call SAPI POST Contact Create">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI POST Contact"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            id: "003bm00000NEW789",
                            firstName: "Tom",
                            lastName: "New",
                            email: "tom@newcorp.com"
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 201
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Process Contact New Creation Event">
                <munit:variables>
                    <munit:variable
                        key="originalPayload"
                        value='#[{
                            firstName: "Tom",
                            lastName: "New",
                            email: "tom@newcorp.com"
                        }]'
                        mediaType="application/java"/>
                    <munit:variable
                        key="finalAccountId"
                        value='#["001bm00000ABC123"]'
                        mediaType="application/java"/>
                </munit:variables>
            </munit:set-event>

            <flow-ref
                doc:name="Execute process-contact-logic-sub-flow New"
                name="process-contact-logic-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert finalContactId set from new contact POST response"
                expression="#[vars.finalContactId]"
                is='#[MunitTools::equalTo("003bm00000NEW789")]'/>

            <munit-tools:verify-call
                doc:name="Verify GET Contact By Email called once"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI GET Contact By Email"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

            <munit-tools:verify-call
                doc:name="Verify POST Contact called once to create"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call SAPI POST Contact"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ================================================================ -->
    <!-- TEST 6: create-account-sub-flow                                  -->
    <!-- Processors: logger + transform + POST (target=accountResult)     -->
    <!-- FIX: whereValue uses exact production doc:name "Call Sys API POST Account" -->
    <!-- FIX: 'type' key quoted correctly as "type" inside single-quoted attribute -->
    <!-- ================================================================ -->
<munit:test
        name="create-account-success"
        description="create-account-sub-flow builds account payload and stores POST response in accountResult">

    <munit:behavior>

        <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call Sys API POST Account">

            <munit-tools:with-attributes>
                <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Sys API POST Account"/>
            </munit-tools:with-attributes>

            <munit-tools:then-return>

                <munit-tools:variables>
                    <munit-tools:variable
                            key="accountResult"
                            mediaType="application/java"
                            value='#[{
                                id: "001bm00000SYS999",
                                name: "Sys Corp",
                                "type": "Customer"
                            }]'/>
                </munit-tools:variables>

            </munit-tools:then-return>

        </munit-tools:mock-when>

    </munit:behavior>

    <munit:execution>

        <munit:set-event doc:name="Set Create Account Sub Flow Event">

            <munit:variables>
                <munit:variable
                        key="originalPayload"
                        mediaType="application/java"
                        value='#[{
                            accountName: "Sys Corp",
                            firstName: "Alice",
                            lastName: "Cooper",
                            email: "alice@syscorp.com"
                        }]'/>
            </munit:variables>

        </munit:set-event>

        <flow-ref
                doc:name="Execute create-account-sub-flow"
                name="create-account-sub-flow"/>

    </munit:execution>

    <munit:validation>

        <munit-tools:assert-that
                doc:name="Assert Account Result ID"
                expression="#[vars.accountResult.id]"
                is='#[MunitTools::equalTo("001bm00000SYS999")]'/>

        <munit-tools:assert-that
                doc:name="Assert Account Result Name"
                expression="#[vars.accountResult.name]"
                is='#[MunitTools::equalTo("Sys Corp")]'/>

        <munit-tools:assert-that
                doc:name="Assert Account Result Type"
                expression='#[vars.accountResult."type"]'
                is='#[MunitTools::equalTo("Customer")]'/>

        <munit-tools:verify-call
                doc:name="Verify POST Account Called Once"
                processor="http:request"
                times="1">

            <munit-tools:with-attributes>
                <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Sys API POST Account"/>
            </munit-tools:with-attributes>

        </munit-tools:verify-call>

    </munit:validation>

</munit:test>
    <!-- ================================================================ -->
    <!-- TEST 7: create-contact-sub-flow                                  -->
    <!-- Processors: logger + transform + POST contact                    -->
    <!-- ================================================================ -->

    <munit:test
        name="create-contact-success"
        description="create-contact-sub-flow builds contact payload and POSTs to SAPI">

        <munit:behavior>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock Call Sys API POST Contact">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Sys API POST Contact"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[{
                            id: "003bm00000CTX888",
                            firstName: "Alice",
                            lastName: "Cooper",
                            email: "alice@syscorp.com"
                        }]'/>

                    <munit-tools:attributes
                        mediaType="application/java"
                        value="#[{
                            statusCode: 201
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Create Contact Sub Flow Event">
                <munit:variables>
                    <munit:variable
                        key="originalPayload"
                        value='#[{
                            firstName: "Alice",
                            lastName: "Cooper",
                            email: "alice@syscorp.com"
                        }]'
                        mediaType="application/java"/>
                    <munit:variable
                        key="accountResult"
                        value='#[{
                            id: "001bm00000SYS999"
                        }]'
                        mediaType="application/java"/>
                </munit:variables>
            </munit:set-event>

            <flow-ref
                doc:name="Execute create-contact-sub-flow"
                name="create-contact-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert payload id from POST response"
                expression="#[payload.id]"
                is='#[MunitTools::equalTo("003bm00000CTX888")]'/>

            <munit-tools:verify-call
                doc:name="Verify POST Contact called once in create-contact-sub-flow"
                processor="http:request"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Sys API POST Contact"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

</mule>