    <!-- ========================================================= -->
    <!-- TEST 06: CREATE ACCOUNT SUBFLOW                           -->
    <!-- ========================================================= -->

    <munit:test
        name="create-account-success-test"
        description="Verify create-account-sub-flow builds the account request and stores the response">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Create Account Subflow Request"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Create Account"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:variables>

                        <munit-tools:variable
                            key="accountResult"
                            mediaType="application/json"
                            value="#[output application/json
---
{
    id: '001bm00000SYS999',
    name: 'System Corp',
    'type': 'Customer'
}]"/>

                    </munit-tools:variables>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Account Creation Subflow Event">

                <munit:variables>

                    <munit:variable
                        key="originalPayload"
                        mediaType="application/json"
                        value="#[output application/json
---
{
    accountName: 'System Corp',
    firstName: 'Alice',
    lastName: 'Cooper',
    email: 'alice@systemcorp.com'
}]"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                doc:name="Execute Create Account Subflow"
                name="create-account-sub-flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Account Result ID"
                expression="#[vars.accountResult.id]"
                is="#[MunitTools::equalTo('001bm00000SYS999')]"/>

            <munit-tools:assert-that
                doc:name="Assert Account Result Name"
                expression="#[vars.accountResult.name]"
                is="#[MunitTools::equalTo('System Corp')]"/>

            <munit-tools:assert-that
                doc:name="Assert Account Result Type"
                expression="#[vars.accountResult['type']]"
                is="#[MunitTools::equalTo('Customer')]"/>

            <munit-tools:verify-call
                doc:name="Verify Create Account Subflow Request Called Once"
                processor="http:request"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Create Account"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ========================================================= -->
