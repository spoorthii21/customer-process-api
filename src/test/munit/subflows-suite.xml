        <munit:execution>

            <munit:set-event doc:name="Set Contact Creation Subflow Event">

                <munit:variables>

                    <munit:variable
                        key="originalPayload"
                        mediaType="application/json"
                        value="#[output application/json
---
{
    firstName: 'Alice',
    lastName: 'Cooper',
    email: 'alice@systemcorp.com'
}]"/>

                    <munit:variable
                        key="accountResult"
                        mediaType="application/json"
