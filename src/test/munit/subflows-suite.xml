        name="create-contact-success-test"
        description="Verify create-contact-sub-flow builds the contact request and returns the created contact">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce System API Create Contact Subflow Request"
                processor="http:request">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Call Salesforce System API Create Contact"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/json"
                        value="#[output application/json
---
{
    id: '003bm00000CTX888',
    firstName: 'Alice',
    lastName: 'Cooper',
    email: 'alice@systemcorp.com'
}]"/>

                    <munit-tools:attributes
